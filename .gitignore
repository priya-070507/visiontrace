# ================================
# VisionTrace - Git Ignore
# ================================

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Python virtual environments
.venv/
venv/
env/
backend/.venv/

# Environment / secrets
.env
*.env
!.env.example

# Generated backend files
backend/uploads/*
backend/results/*

# Keep empty directories
!backend/uploads/.gitkeep
!backend/results/.gitkeep

# Node
node_modules/
frontend/node_modules/

# Vite build
frontend/dist/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/

# Temporary project inspection
structure.txt